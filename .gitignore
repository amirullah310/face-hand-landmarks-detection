# Ignore Dokumen & Laporan
*.docx
*.pdf
*.doc
~$*

# Python cache & virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Hasil deteksi landmark (jangan di-upload)
output.png
output*.png
**/output/
**/snapshot.*
**/screenshot_*.*

# File model MediaPipe (diunduh otomatis oleh program)
*.task
*.tflite

# File rahasia
.env
*.key
*.pem

# Log dan file sementara
*.log
*.tmp
*.temp
